:root {
  --bg: #f7f8fc;
  --card: #ffffff;
  --text: #171a23;
  --muted: #586071;
  --brand: #2f6df6;
  --brand-dark: #1f55d7;
  --line: #e8ebf3;
  --soft: #eef4ff;
}

* {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  margin: 0;
  font-family: 'Pretendard', 'Segoe UI', sans-serif;
  background: var(--bg);
  color: var(--text);
}

a {
  color: inherit;
  text-decoration: none;
}

button {
  border: none;
  cursor: pointer;
  font: inherit;
}

.page {
  min-height: 100vh;
}

.topbar {
  max-width: 1200px;
  margin: 0 auto;
  padding: 18px 24px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  position: sticky;
  top: 0;
  background: rgba(247, 248, 252, 0.9);
  backdrop-filter: blur(10px);
}

.brand {
  font-weight: 800;
  font-size: 1.1rem;
}

.topbar nav {
  display: flex;
  gap: 20px;
  color: var(--muted);
  font-size: 0.95rem;
}

.primary-btn,
.secondary-btn {
  border-radius: 12px;
  padding: 14px 20px;
  font-weight: 700;
}

.primary-btn {
  background: var(--brand);
  color: white;
  box-shadow: 0 10px 24px rgba(47, 109, 246, 0.2);
}

.primary-btn:hover {
  background: var(--brand-dark);
}

.secondary-btn {
  background: white;
  color: var(--text);
  border: 1px solid var(--line);
}

.hero,
.section-inner,
.footer-inner {
  max-width: 1200px;
  margin: 0 auto;
  padding: 64px 24px;
}

.hero {
  display: grid;
  grid-template-columns: 1.3fr 0.7fr;
  align-items: center;
  gap: 24px;
  min-height: 620px;
}

.badge {
  display: inline-block;
  padding: 8px 12px;
  background: var(--soft);
  color: var(--brand-dark);
  border-radius: 999px;
  font-size: 0.8rem;
  font-weight: 700;
  margin-bottom: 18px;
}

.hero-copy h1 {
  font-size: clamp(2.5rem, 6vw, 4.4rem);
  line-height: 1.08;
  margin: 0 0 18px;
}

.hero-copy p {
  max-width: 620px;
  color: var(--muted);
  font-size: 1.1rem;
  line-height: 1.7;
  margin: 0 0 24px;
}

.cta-row {
  display: flex;
  gap: 12px;
  flex-wrap: wrap;
}

.hero-card {
  background: var(--card);
  border: 1px solid var(--line);
  border-radius: 20px;
  box-shadow: 0 24px 60px rgba(25, 38, 63, 0.08);
  padding: 26px;
}

.mini-label {
  font-size: 0.8rem;
  font-weight: 700;
  color: var(--brand-dark);
  margin-bottom: 18px;
}

.hero-card ul {
  list-style: none;
  padding: 0;
  margin: 0 0 20px;
  display: grid;
  gap: 10px;
  color: var(--muted);
}

.score-row {
  display: flex;
  justify-content: space-between;
  padding-top: 18px;
  border-top: 1px solid var(--line);
  font-weight: 700;
}

.section {
  border-top: 1px solid var(--line);
}

.section-inner h2 {
  font-size: clamp(2rem, 4vw, 3rem);
  margin-bottom: 18px;
}

.bullet-list {
  list-style: disc;
  padding-left: 20px;
  color: var(--muted);
  line-height: 1.9;
  font-size: 1.05rem;
}

.feature-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(220px, 1fr));
  gap: 18px;
  margin-top: 24px;
}

.feature-card {
  background: var(--card);
  border: 1px solid var(--line);
  border-radius: 18px;
  padding: 22px 18px;
}

.feature-card h3 {
  margin: 0 0 10px;
  font-size: 1.1rem;
}

.feature-card p {
  margin: 0;
  color: var(--muted);
  line-height: 1.7;
}

.step-list {
  display: grid;
  grid-template-columns: repeat(3, minmax(200px, 1fr));
  gap: 18px;
  margin-top: 20px;
}

.step {
  background: var(--card);
  border: 1px solid var(--line);
  border-radius: 16px;
  padding: 22px;
  font-weight: 700;
  min-height: 90px;
  display: flex;
  align-items: center;
}

.lead {
  font-size: 1.08rem;
  line-height: 1.9;
  color: var(--muted);
  margin-top: 18px;
}

.footer {
  border-top: 1px solid var(--line);
  background: #fff;
  margin-top: 32px;
}

.footer-inner {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16px;
}

@media (max-width: 860px) {
  .hero {
    grid-template-columns: 1fr;
  }

  .feature-grid,
  .step-list {
    grid-template-columns: 1fr;
  }

  .topbar {
    flex-wrap: wrap;
    gap: 12px;
  }

  .topbar nav {
    order: 3;
    width: 100%;
    justify-content: center;
  }

  .footer-inner {
    flex-direction: column;
    align-items: flex-start;
  }
}
